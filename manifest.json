{
  "schema": 4,
  "required_executas": [
    {
      "tool_id": "bundled:youtube-skillbox",
      "min_version": "0.1.0",
      "version": "latest"
    }
  ],
  "tags": [
    "youtube",
    "creator-tools",
    "seo",
    "keyword-research",
    "channel-audit",
    "growth"
  ],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "YouTube Skillbox",
        "default": true,
        "default_size": {
          "w": 1080,
          "h": 720
        },
        "min_size": {
          "w": 720,
          "h": 480
        },
        "resizable": true,
        "movable": true,
        "single_instance": true
      }
    ],
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "fixtures": [],
    "seed_storage": {},
    "user_id": 1
  }
}
